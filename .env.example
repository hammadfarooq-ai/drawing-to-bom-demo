# Copy this file to .env and fill in your key.
OPENAI_API_KEY=sk-your-key-here

# Vision-capable model with Structured Outputs support.
# gpt-6.2-sol is OpenAI's balanced model (image input + structured outputs).
# Use gpt-6.2-astra for maximum accuracy, or gpt-6-luna for the cheapest runs.
OPENAI_MODEL=gpt-6.2-sol
